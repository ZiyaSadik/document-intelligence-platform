# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Anthropic (required for extraction) ---------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Model used for vision + structured extraction.
# claude-opus-5 = best accuracy; claude-sonnet-5 = ~2.5x cheaper.
ANTHROPIC_MODEL=claude-opus-5
# Effort level passed to the model: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=32000
ANTHROPIC_TIMEOUT_SECONDS=300
ANTHROPIC_MAX_RETRIES=2

# --- Persistence ----------------------------------------------------------
# Local default is SQLite. In deployment use the PostgreSQL URL provided by
# your host, e.g. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# --- Upload limits / document validation ---------------------------------
MAX_UPLOAD_MB=20
MAX_PAGE_COUNT=3

# --- OCR / rasterisation --------------------------------------------------
# A PDF page yielding at least this many characters uses its native text
# layer; otherwise the page is rasterised and sent to the vision model.
TEXT_LAYER_MIN_CHARS=200
RASTER_DPI=200
MAX_IMAGE_EDGE_PX=2000
JPEG_QUALITY=85

# --- Financial validation tolerance --------------------------------------
# A check passes when |calculated - reported| <= ABS + REL * magnitude.
# ABS absorbs rounding at the printed precision; REL lets that grow with scale.
VALIDATION_ABS_TOLERANCE=0.1
VALIDATION_REL_TOLERANCE=0.00001

# --- App ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
ENVIRONMENT=local
